{
  "name": "truckeelights",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:functions": "deno test --config supabase/functions/deno.json supabase/functions",
    "db:start": "sh supabase/start-local.sh",
    "db:reset": "supabase db reset && sh supabase/storage-jobs-local.sh",
    "db:test": "supabase test db",
    "test:concurrency": "node --test 'tests/db-concurrency/*.test.mjs'",
    "test:storage": "node --test --test-concurrency=1 'tests/storage/*.test.mjs'"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.3",
    "@marsidev/react-turnstile": "1.6.3",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.4",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/google.maps": "3.66.9",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
