# Local Supabase stack only. Never put hosted values here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Paste the "Publishable key" printed by `supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare always-pass test key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Empty selects the map stub
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_ID_HALLOWEEN=
NEXT_PUBLIC_MAP_ID_CHRISTMAS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
